# ===== 飞书 (Feishu / Lark) =====
# 自建应用（用于 Bitable 读写、卡片回调）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格 App Token (URL 里 base/ 后面那段)
BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxxxxx

# 群机器人 Webhook (用于周报/告警推送)
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxxx

# 群机器人签名校验 key (群设置 → 机器人 → 添加签名校验)
FEISHU_BOT_SECRET=

# ===== Firecrawl (用于 1688 供应商价格监控) =====
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== ProfitLens (Phase 2 可选) =====
PROFITLENS_API_URL=http://localhost:8000
PROFITLENS_API_TOKEN=

# ===== 算法参数 =====
DEFAULT_SAFETY_STOCK_DAYS=14
SALES_HISTORY_WINDOW_DAYS=30
FORECAST_HORIZON_DAYS=90
DEAD_STOCK_DECLINE_THRESHOLD=0.35
DEAD_STOCK_CONSECUTIVE_WEEKS=4

# ===== 调度 =====
WEEKLY_ALERT_DAY=mon
WEEKLY_ALERT_HOUR=9
MONTHLY_REVIEW_DAY=1
MONTHLY_REVIEW_HOUR=9

# ===== 环境 =====
ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
